# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build outputs
/.next/
/out/
/dist
/dist-win
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# local data
.data/
# internal docs
SCALABILITY.md
PROJECT_RULES.md

# vercel
.vercel

# typescript
*.tsbuildinfo

# Electron Builder
/dist
/dist-win

# Binaries & Large files (Setup files shouldn't be in git)
public/*.exe
*.7z
groq_docs_reference.md

# Private customer documents stay local; public site assets belong in public/.
/*.pdf
/ZEDX_*Proposal*.md
/private/
/local-docs/

# Local review artifacts and generated test results
/PROJECT_REVIEW_AR.md
/PAYMENT_FIXES_AR.md
/PAYMENT_SECURITY_PROOF.jpg
/results/
/test-results/
/playwright-report/

# Local credentials, agent state, and CLI caches
/.codex/
/.aws/
/supabase/.temp/
*.key
*.p12
*.pfx
